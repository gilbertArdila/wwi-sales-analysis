table 'Measures (2)'
	lineageTag: 3e059693-816c-44f8-bcec-cd61982f48ea

	measure 'Revenue total' = SUM(WWI_project[Revenue])
		formatString: 0
		lineageTag: 62c83b54-aa2b-41df-b994-234290e3183b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Revenue Total M' =
			
			DIVIDE([Revenue Total],1000000)
		formatString: 0.0
		lineageTag: cd65ab54-6127-4a2d-9263-c8c47b0f885e

	measure 'Profit total' = SUM(WWI_project[Profit])
		lineageTag: 4c85307e-7586-462b-a11f-6bff7cb99366

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit total M' = DIVIDE([Profit total],1000000)
		formatString: 0.0
		lineageTag: 61272f6f-955b-43e4-80e8-eaf0f6c5f009

	measure 'FillRate %' = AVERAGE(WWI_project[FillRate])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: aed88871-497e-4d02-9862-cca4bc469463

	measure 'Margin %' = AVERAGE(WWI_project[MarginPercent])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b5322a13-aad0-43c7-b700-917a5aaaef9f

	measure Orders = DISTINCTCOUNT(WWI_project[OrderID])
		formatString: 0.0
		lineageTag: 7388d57f-723e-492b-8231-54ba3c04d952

	measure Customers = DISTINCTCOUNT(WWI_project[CustomerID])
		formatString: 0
		lineageTag: a92b8737-9e29-4d5f-94e0-cfc35710789a

	measure 'Average ticket' = DIVIDE([Revenue total],[Orders])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b933b9a6-64f9-4b05-a519-b3fd2dadc37f

	measure 'Orders per customer' = COUNT(WWI_project[OrderID])
		formatString: 0
		lineageTag: 3e2ca864-9985-479f-a596-b448108f0671

	measure 'Customer Average Ticket' =
			
			DIVIDE(
			    [Revenue Total],
			    [Orders per Customer]
			)
		lineageTag: a8ce3808-08fc-43d7-8e19-6fffa317906a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

